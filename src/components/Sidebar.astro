---
/**
 * Dashboard sidebar — left rail with nav, account section, plan badge,
 * and persistent upgrade CTA for free users.
 *
 * Linear-style density: thin icons, small labels, lots of whitespace.
 * Active state uses a soft brand-tinted background instead of a bar.
 */
import type { SessionUser } from '~/lib/auth';

interface Props {
  active: 'overview' | 'brands' | 'audits' | 'settings';
  user: SessionUser;
}
const { active, user } = Astro.props;

const nav = [
  { key: 'overview', label: 'Overview',  href: '/dashboard',          iconPath: 'M3 12l9-9 9 9M5 10v10h14V10' },
  { key: 'brands',   label: 'Brands',    href: '/dashboard/brands',   iconPath: 'M3 7l9 5 9-5M3 7v10l9 5 9-5V7M3 7l9-5 9 5' },
  { key: 'audits',   label: 'Audits',    href: '/dashboard/audits',   iconPath: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
  { key: 'settings', label: 'Settings',  href: '/dashboard/settings', iconPath: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065zM15 12a3 3 0 11-6 0 3 3 0 016 0z' },
];

const planLabel: Record<string, string> = {
  free:   'Free plan',
  solo:   'Solo plan',
  pro:    'Pro plan',
  agency: 'Agency plan',
};
const isFree = user.plan === 'free';
---

<aside class="w-60 shrink-0 border-r flex flex-col sticky top-0 h-screen"
       style="background: var(--color-surface); border-color: var(--color-border);">

  <!-- Brand mark -->
  <a href="/dashboard" class="flex items-center gap-2.5 px-5 py-5 group">
    <span class="inline-block w-7 h-7 shrink-0">
      <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" class="block w-full h-full">
        <defs>
          <linearGradient id="onswer-sb-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%"   stop-color="#4F46E5"/>
            <stop offset="50%"  stop-color="#7C3AED"/>
            <stop offset="100%" stop-color="#06B6D4"/>
          </linearGradient>
        </defs>
        <circle cx="32" cy="32" r="20" fill="none" stroke="url(#onswer-sb-grad)" stroke-width="3" stroke-linecap="round"/>
        <circle cx="32" cy="32" r="5" fill="url(#onswer-sb-grad)"/>
      </svg>
    </span>
    <span class="font-semibold tracking-tight text-[15px]" style="color: var(--color-ink);">Onswer</span>
  </a>

  <!-- Nav -->
  <nav class="flex-1 px-3 pt-2 space-y-0.5">
    {nav.map(item => {
      const isActive = item.key === active;
      return (
        <a href={item.href}
           class:list={['flex items-center gap-2.5 px-3 py-2 rounded-lg text-[13px] font-medium transition-colors']}
           style={isActive
              ? 'background: var(--color-brand-soft); color: var(--color-brand-hover);'
              : 'color: var(--color-ink-muted);'}
           data-nav-item>
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d={item.iconPath}/>
          </svg>
          <span>{item.label}</span>
        </a>
      );
    })}
  </nav>

  <!-- Plan card / upgrade CTA -->
  <div class="px-3 pb-3 pt-4 mt-auto">
    {isFree ? (
      <div class="rounded-xl p-3.5"
           style="background: linear-gradient(135deg, #EEF2FF 0%, #FAF5FF 100%); border: 1px solid var(--color-brand-line);">
        <p class="text-[11px] uppercase tracking-wider font-semibold" style="color: var(--color-brand-hover);">
          You're on Free
        </p>
        <p class="mt-1.5 text-[13px] leading-snug" style="color: var(--color-ink);">
          Upgrade to monitor your brand continuously, not just once.
        </p>
        <a href="https://onswer.app/#pricing"
           class="mt-3 inline-flex items-center gap-1.5 text-[12px] font-semibold transition-colors"
           style="color: var(--color-brand-hover);">
          See plans
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    ) : (
      <div class="rounded-xl p-3 border" style="border-color: var(--color-border); background: var(--color-surface-muted);">
        <p class="text-[11px] uppercase tracking-wider font-semibold" style="color: var(--color-ok);">
          {planLabel[user.plan]}
        </p>
        <p class="mt-1 text-[12px]" style="color: var(--color-ink-muted);">
          Continuous monitoring active
        </p>
      </div>
    )}
  </div>

  <!-- Account row -->
  <div class="px-3 pb-4 border-t pt-3" style="border-color: var(--color-border);">
    <a href="/dashboard/settings"
       class="flex items-center gap-2.5 px-2 py-1.5 rounded-lg transition-colors hover:bg-[var(--color-surface-hover)]">
      <span class="w-7 h-7 rounded-full inline-flex items-center justify-center text-[11px] font-semibold uppercase"
            style="background: var(--color-brand-soft); color: var(--color-brand-hover);">
        {user.email.charAt(0)}
      </span>
      <span class="text-[12px] truncate" style="color: var(--color-ink);">{user.email}</span>
    </a>
  </div>
</aside>
