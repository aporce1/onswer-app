---
/**
 * ScanningBanner — premium "audit in progress" hero.
 *
 * Rendered at the top of /dashboard/brands/[id] whenever the most recent
 * audit is in status="running". Goes away when the audit completes/fails.
 *
 * Visual design:
 *   - Indigo→purple→cyan gradient backdrop (the Onswer brand chord)
 *   - SVG radar with a sweeping beam + pulsing center + pinging rings
 *   - Cells-processed / cells-expected with animated gradient progress bar
 *   - Live elapsed time + ETA estimated from current cell rate
 *   - Subtle "scanning across 8 LLMs and 3 geos" caption so the user
 *     understands why this takes minutes, not seconds
 *
 * Companion: when this banner is on the page, the layout injects a meta-
 * refresh that reloads every 15s so the progress bar advances on its own.
 */

interface Props {
  domain: string;
  /** Cells already in DB (a.answers_count from the running audit). */
  cellsDone: number;
  /** Total expected cells from plan limits — used for the progress %. */
  cellsExpected: number;
  /** Number of LLMs in the matrix — shown in the caption. */
  llms: number;
  /** Number of geos in the matrix. */
  geos: number;
  /** When the audit started_at — for ETA + elapsed calculation. */
  startedAt: string | null;
}

const { domain, cellsDone, cellsExpected, llms, geos, startedAt } = Astro.props;

// Defensive clamps so a weird payload can't produce NaN / >100% widths.
const safeDone     = Math.max(0, cellsDone);
const safeExpected = Math.max(safeDone, cellsExpected);
const pct          = safeExpected > 0 ? Math.min(100, Math.round((safeDone / safeExpected) * 100)) : 0;

// Elapsed + ETA — computed server-side on each refresh (every 15s) so
// the numbers move forward without client JS.
const startedTs = startedAt ? new Date(startedAt.replace(' ', 'T') + 'Z').getTime() : null;
const nowTs     = Date.now();
const elapsedSec = startedTs ? Math.max(0, Math.floor((nowTs - startedTs) / 1000)) : 0;

let etaText = '';
if (startedTs && safeDone >= 10 && elapsedSec > 5) {
  const rate = safeDone / elapsedSec;        // cells/sec
  const remaining = safeExpected - safeDone;
  if (rate > 0) {
    const etaSec = Math.max(0, Math.round(remaining / rate));
    etaText = etaSec < 60
      ? `~${etaSec}s remaining`
      : `~${Math.ceil(etaSec / 60)} min remaining`;
  }
} else if (safeDone < 10) {
  etaText = 'estimating…';
}

const elapsedText = elapsedSec < 60
  ? `${elapsedSec}s`
  : `${Math.floor(elapsedSec / 60)}m ${elapsedSec % 60}s`;
---

<div class="scanning-banner mb-6 relative overflow-hidden rounded-2xl"
     style="border: 1px solid var(--color-brand-line);">

  <!-- Animated gradient backdrop layer -->
  <div class="absolute inset-0 -z-10 opacity-90"
       style="background: linear-gradient(135deg, #EEF2FF 0%, #F5F3FF 35%, #ECFEFF 100%);"></div>
  <div class="absolute inset-0 -z-10 scanning-aurora"></div>

  <div class="relative px-6 py-5 flex items-center gap-5 flex-wrap">

    <!-- Radar SVG with sweeping beam + pulsing center -->
    <div class="shrink-0 relative">
      <svg viewBox="0 0 100 100" class="w-14 h-14 block">
        <defs>
          <linearGradient id="radar-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%"   stop-color="#4F46E5"/>
            <stop offset="50%"  stop-color="#7C3AED"/>
            <stop offset="100%" stop-color="#06B6D4"/>
          </linearGradient>
          <radialGradient id="sweep-grad" cx="50%" cy="50%" r="50%">
            <stop offset="0%"   stop-color="#6366F1" stop-opacity="0.45"/>
            <stop offset="100%" stop-color="#6366F1" stop-opacity="0"/>
          </radialGradient>
        </defs>

        <!-- Concentric rings -->
        <circle cx="50" cy="50" r="44" fill="none" stroke="url(#radar-grad)" stroke-width="1.2" opacity="0.35"/>
        <circle cx="50" cy="50" r="30" fill="none" stroke="url(#radar-grad)" stroke-width="1.2" opacity="0.5"/>
        <circle cx="50" cy="50" r="16" fill="none" stroke="url(#radar-grad)" stroke-width="1.2" opacity="0.65"/>

        <!-- Rotating sweep -->
        <g class="radar-sweep" style="transform-origin: 50px 50px;">
          <path d="M 50 50 L 50 6 A 44 44 0 0 1 88 28 Z" fill="url(#sweep-grad)"/>
          <line x1="50" y1="50" x2="50" y2="6" stroke="#6366F1" stroke-width="1.5" opacity="0.8"/>
        </g>

        <!-- Pinging blip dots at fixed positions -->
        <circle cx="72" cy="38" r="2.5" fill="#7C3AED" class="radar-blip" style="animation-delay: 0.4s;"/>
        <circle cx="34" cy="62" r="2.5" fill="#06B6D4" class="radar-blip" style="animation-delay: 1.6s;"/>
        <circle cx="62" cy="74" r="2"   fill="#4F46E5" class="radar-blip" style="animation-delay: 2.8s;"/>

        <!-- Pulsing core -->
        <circle cx="50" cy="50" r="5" fill="url(#radar-grad)" class="radar-core"/>
      </svg>
    </div>

    <!-- Main text block -->
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2.5 mb-1">
        <p class="text-[11px] uppercase tracking-[0.18em] font-semibold scanning-shimmer-text">
          Scanning live
        </p>
        <span class="inline-flex items-center gap-1.5 text-[10px] font-medium px-2 py-0.5 rounded-full"
              style="background: rgba(255,255,255,0.7); color: var(--color-brand-hover); backdrop-filter: blur(4px);">
          <span class="w-1.5 h-1.5 rounded-full" style="background: var(--color-brand); animation: pulse-dot 1.5s ease-in-out infinite;"></span>
          {pct}%
        </span>
      </div>
      <h3 class="text-base font-semibold tracking-tight truncate" style="color: var(--color-ink);">
        Asking the LLMs about <span class="font-mono">{domain}</span>
      </h3>
      <p class="mt-1 text-xs leading-relaxed" style="color: var(--color-ink-muted);">
        {safeDone.toLocaleString()} of {safeExpected.toLocaleString()} cells &middot; {llms} models &middot; {geos} {geos === 1 ? 'geography' : 'geographies'}
      </p>
    </div>

    <!-- Time block -->
    <div class="shrink-0 text-right">
      <p class="text-[10px] uppercase tracking-wider font-semibold" style="color: var(--color-ink-subtle);">Elapsed</p>
      <p class="text-sm font-mono tabular-nums" style="color: var(--color-ink);">{elapsedText}</p>
      {etaText && (
        <p class="text-[11px] mt-0.5 font-mono" style="color: var(--color-brand-hover);">
          {etaText}
        </p>
      )}
    </div>
  </div>

  <!-- Progress bar (animated gradient + shimmer overlay) -->
  <div class="relative h-1.5 w-full overflow-hidden"
       style="background: rgba(99, 102, 241, 0.08);">
    <div class="h-full scanning-progress-fill rounded-r"
         style={`width: ${pct}%;`}></div>
    <div class="absolute inset-0 scanning-progress-shimmer pointer-events-none"></div>
  </div>
</div>

<style>
  /* Sweeping radar beam — 3s linear rotation, continuous. */
  @keyframes radar-rotate {
    from { transform: rotate(0deg);   }
    to   { transform: rotate(360deg); }
  }
  .radar-sweep {
    animation: radar-rotate 3s linear infinite;
  }

  /* Center dot pulse — breathes between r=4 and r=6 with opacity drop. */
  @keyframes radar-core-pulse {
    0%, 100% { opacity: 1;   transform: scale(1);    }
    50%      { opacity: 0.6; transform: scale(1.35); }
  }
  .radar-core {
    transform-origin: 50px 50px;
    animation: radar-core-pulse 1.8s ease-in-out infinite;
  }

  /* Detection blips appear/fade as the sweep "discovers" them. */
  @keyframes radar-blip {
    0%, 90%, 100% { opacity: 0;   transform: scale(0.6); }
    5%, 25%       { opacity: 0.9; transform: scale(1);   }
    50%           { opacity: 0;   transform: scale(2);   }
  }
  .radar-blip {
    transform-box: fill-box;
    transform-origin: center;
    animation: radar-blip 4s ease-out infinite;
  }

  /* Aurora — a slow-moving soft gradient on top of the static bg to add life. */
  @keyframes aurora-drift {
    0%   { transform: translate3d(-10%, 0, 0) rotate(0deg);   }
    50%  { transform: translate3d(10%, 5%, 0) rotate(180deg); }
    100% { transform: translate3d(-10%, 0, 0) rotate(360deg); }
  }
  .scanning-aurora {
    background:
      radial-gradient(600px 200px at 20% 50%, rgba(99,102,241,0.20), transparent 60%),
      radial-gradient(500px 220px at 80% 50%, rgba(6,182,212,0.18), transparent 60%);
    filter: blur(20px);
    animation: aurora-drift 14s ease-in-out infinite;
  }

  /* "SCANNING LIVE" text gets a moving gradient shimmer. */
  @keyframes text-shimmer {
    0%   { background-position:   0% 50%; }
    100% { background-position: 200% 50%; }
  }
  .scanning-shimmer-text {
    background: linear-gradient(90deg, #6366F1 0%, #7C3AED 25%, #06B6D4 50%, #7C3AED 75%, #6366F1 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: text-shimmer 3s linear infinite;
  }

  /* Progress bar fill: hard gradient + pulse glow at the leading edge. */
  .scanning-progress-fill {
    background: linear-gradient(90deg, #4F46E5 0%, #7C3AED 60%, #06B6D4 100%);
    transition: width 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    position: relative;
  }
  .scanning-progress-fill::after {
    content: '';
    position: absolute;
    right: -8px;
    top: 50%;
    transform: translateY(-50%);
    width: 8px;
    height: 100%;
    background: radial-gradient(circle, #06B6D4 0%, transparent 70%);
    filter: blur(2px);
    opacity: 0.9;
  }

  /* Diagonal shimmer that sweeps across the progress bar. */
  @keyframes progress-shimmer {
    0%   { transform: translateX(-100%); }
    100% { transform: translateX(100%);  }
  }
  .scanning-progress-shimmer {
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.6) 50%,
      transparent 100%
    );
    animation: progress-shimmer 2.2s ease-in-out infinite;
  }

  /* Generic dot pulse — used for the % chip indicator. */
  @keyframes pulse-dot {
    0%, 100% { opacity: 1;   transform: scale(1);    }
    50%      { opacity: 0.4; transform: scale(1.4);  }
  }

  /* Respect users who prefer no animation. */
  @media (prefers-reduced-motion: reduce) {
    .radar-sweep, .radar-core, .radar-blip,
    .scanning-aurora, .scanning-shimmer-text,
    .scanning-progress-shimmer {
      animation: none !important;
    }
  }
</style>
