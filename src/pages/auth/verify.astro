---
/**
 * /auth/verify?token=...
 *
 * The user clicked the magic link in their email. We:
 *   1. POST the token to api.onswer.app/v1/auth/magic-link/verify
 *   2. Read the JWT + TTL out of the response body
 *   3. Set the `onswer_session` cookie HERE, on app.onswer.app, with
 *      Domain=.onswer.app so it travels to api.* on subsequent fetches.
 *   4. Redirect to /dashboard
 *
 * We deliberately do NOT forward the API's Set-Cookie header — Node fetch
 * + Astro + Vercel make that chain unreliable (cookie sometimes lost mid-
 * stream). Setting the cookie locally with Astro.cookies.set() is rock-solid
 * and gives us full control over Domain/Secure/SameSite/MaxAge.
 */
import AuthLayout from '~/layouts/AuthLayout.astro';

const token = Astro.url.searchParams.get('token') ?? '';
let errorMsg: string | null = null;

if (!token) {
  errorMsg = 'Missing token. Open the link from your email again.';
} else {
  const apiUrl = (import.meta.env.PUBLIC_API_URL || 'http://api.onswer.local') + '/v1/auth/magic-link/verify';
  try {
    const res = await fetch(apiUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ token }),
    });

    const body = await res.json().catch(() => null);

    if (res.ok && body?.ok && body?.data?.token) {
      const jwt: string = body.data.token;
      const ttl: number = Number(body.data.expires_in_s) || 60 * 60 * 24 * 7;

      // Derive the cookie domain from PUBLIC_SITE_URL so we share with
      // api.onswer.app in prod and api.onswer.local in dev.
      // app.onswer.app    → .onswer.app
      // app.onswer.local  → .onswer.local
      // localhost:4322    → undefined (host-only cookie, dev-only edge)
      const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://app.onswer.app';
      const host    = new URL(siteUrl).hostname;
      const labels  = host.split('.');
      const cookieDomain =
        host === 'localhost' || /^\d+\.\d+\.\d+\.\d+$/.test(host)
          ? undefined
          : '.' + labels.slice(1).join('.');

      Astro.cookies.set('onswer_session', jwt, {
        path: '/',
        domain: cookieDomain,
        httpOnly: true,
        secure: siteUrl.startsWith('https://'),
        sameSite: 'lax',
        maxAge: ttl,
      });

      return Astro.redirect('/dashboard', 302);
    }

    errorMsg = (body && typeof body === 'object' && 'error' in body)
      ? String(body.error)
      : 'Link expired or already used. Sign in again.';
  } catch (e) {
    errorMsg = 'Could not reach the server. Try again in a moment.';
  }
}
---
<AuthLayout title="Verifying">
  <div class="card p-8 text-center">
    {errorMsg ? (
      <>
        <div class="w-14 h-14 mx-auto rounded-full inline-flex items-center justify-center"
             style="background: var(--color-bad-soft);">
          <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"
               style="color: var(--color-bad);">
            <path d="M12 9v4M12 17h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <h2 class="mt-5 text-xl font-semibold tracking-tight" style="color: var(--color-ink);">
          We couldn't sign you in
        </h2>
        <p class="mt-2 text-sm" style="color: var(--color-ink-muted);">
          {errorMsg}
        </p>
        <a href="/login" class="btn-primary mt-6">Try again</a>
      </>
    ) : (
      <>
        <div class="w-14 h-14 mx-auto rounded-full inline-flex items-center justify-center animate-pulse"
             style="background: var(--color-brand-soft);">
          <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"
               style="color: var(--color-brand-hover);">
            <path d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <p class="mt-5 text-sm" style="color: var(--color-ink-muted);">Signing you in…</p>
      </>
    )}
  </div>
</AuthLayout>
