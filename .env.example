# Public API URL — exposed to client + used in SSR fetches.
PUBLIC_API_URL=http://api.onswer.local

# Public site URL — used for canonical URLs + auth callbacks.
# Bind to app.onswer.local in /etc/hosts so cookies with Domain=.onswer.local
# can travel between this dashboard and the PHP API at api.onswer.local.
PUBLIC_SITE_URL=http://app.onswer.local:4322
