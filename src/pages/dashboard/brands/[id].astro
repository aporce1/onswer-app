---
/**
 * /dashboard/brands/[id] — brand detail page.
 *
 * Sprint 2 (now): header + KPI cards + interpretation lines + audits timeline
 *                 table + cadence picker + delete button.
 * Sprint 3 (next): ApexChart score-over-time + latest audit drill-down with
 *                  per-LLM breakdown and recommendations.
 *
 * The page handles the cadence change inline (POST → same URL with action=
 * schedule), and the delete via POST → action=delete → redirect to list.
 * Keeps everything in one place so the user never bounces between pages
 * for state mutations.
 */
import DashboardLayout from '~/layouts/DashboardLayout.astro';
import ScoreChart from '~/components/ScoreChart.astro';
import { requireSession } from '~/lib/auth';
import {
  getBrand, updateBrandSchedule, deleteBrand,
  frequencyLabels, type ScanFrequency,
} from '~/lib/brands';
import {
  interpretScore, interpretScoreDelta, interpretCadence,
} from '~/lib/interpret';

const sessionOrResponse = await requireSession(Astro);
if (sessionOrResponse instanceof Response) return sessionOrResponse;
const user = sessionOrResponse;

const id = Number(Astro.params.id);
if (!Number.isFinite(id) || id <= 0) {
  return Astro.redirect('/dashboard/brands', 302);
}

let flash: string | null = null;

// Handle form submissions (schedule change + delete) before fetching the page.
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  if (action === 'delete') {
    await deleteBrand(Astro, id);
    return Astro.redirect('/dashboard/brands', 302);
  }
  if (action === 'schedule') {
    const freq = String(form.get('scan_frequency') ?? 'paused') as ScanFrequency;
    const res = await updateBrandSchedule(Astro, id, freq);
    if (res.ok && res.data.clamped) {
      flash = `Your plan caps cadence at ${res.data.limits.max_frequency}. Set to that instead.`;
    }
  }
}

const welcomeNew = Astro.url.searchParams.get('welcome') === '1';

const res = await getBrand(Astro, id);
if (!res.ok) {
  return Astro.redirect('/dashboard/brands', 302);
}
const { brand, audits, limits } = res.data;

const planRank: Record<string, number> = { free: 0, solo: 1, pro: 2, agency: 2 };
const userRank = planRank[user.plan] ?? 0;

// Score interpretation (latest)
const latestScore = audits.find(a => a.visibility_score !== null)?.visibility_score ?? null;
const scoreInterp = interpretScore(latestScore);

// Week-over-week delta
const now = Date.now();
const aWeekAgo = audits.find(a =>
  a.visibility_score !== null && a.completed_at !== null
  && (now - new Date((a.completed_at as string).replace(' ', 'T') + 'Z').getTime()) > 5 * 86_400 * 1000
);
const deltaInterp = interpretScoreDelta(latestScore, aWeekAgo?.visibility_score ?? null);

const cadenceText = interpretCadence(brand.scan_frequency, user.plan);

const cadenceOptions: { value: ScanFrequency; label: string; tier: string }[] = [
  { value: 'paused',         label: frequencyLabels.paused,         tier: 'free' },
  { value: 'weekly',         label: frequencyLabels.weekly,         tier: 'solo' },
  { value: 'three_per_week', label: frequencyLabels.three_per_week, tier: 'pro'  },
  { value: 'daily',          label: frequencyLabels.daily,          tier: 'pro'  },
];

function fmtDate(ts: string | null): string {
  if (!ts) return '—';
  const d = new Date(ts.replace(' ', 'T') + 'Z');
  return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
}

const toneColor =
  scoreInterp.tone === 'good' ? 'var(--color-ok)' :
  scoreInterp.tone === 'bad'  ? 'var(--color-bad)' :
  scoreInterp.tone === 'okay' ? 'var(--color-warn)' :
  'var(--color-ink-muted)';
---
<DashboardLayout title={brand.domain} user={user} active="brands">

  <Fragment slot="header-actions">
    <a href="/dashboard/brands" class="btn-secondary">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      All brands
    </a>
  </Fragment>

  {welcomeNew && (
    <div class="rounded-xl p-4 mb-6"
         style="background: var(--color-brand-soft); border: 1px solid var(--color-brand-line); color: var(--color-brand-hover);">
      <p class="font-medium text-sm">Brand created.</p>
      <p class="mt-0.5 text-sm" style="color: var(--color-ink);">
        {brand.scan_frequency === 'paused'
          ? 'Auto-scan is paused. Use the cadence picker below to start tracking.'
          : 'Your first scan is running now — refresh this page in ~90 seconds to see results.'}
      </p>
    </div>
  )}

  {flash && (
    <div class="rounded-xl p-4 mb-6 text-sm"
         style="background: var(--color-warn-soft); color: var(--color-warn);">
      {flash}
    </div>
  )}

  <!-- TWO-COLUMN LAYOUT on wide screens: left = main metrics, right = controls -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">

    <!-- LEFT (2/3): HEADER WITH SCORE + INTERPRETATION ===================== -->
    <div class="lg:col-span-2 card p-7">
      <div class="flex items-start justify-between gap-6 flex-wrap">
        <div>
          <p class="text-xs uppercase tracking-wider font-semibold" style="color: var(--color-ink-subtle);">
            Brand
          </p>
          <h2 class="mt-1 text-2xl font-bold tracking-tight" style="color: var(--color-ink);">{brand.domain}</h2>
          {brand.industry && (
            <p class="mt-1 text-sm" style="color: var(--color-ink-muted);">{brand.industry}</p>
          )}
        </div>

        <div class="text-right">
          <p class="text-xs uppercase tracking-wider font-semibold" style="color: var(--color-ink-subtle);">
            Visibility score
          </p>
          <p class="mt-1 text-5xl font-bold tabular-nums" style={`color: ${toneColor};`}>
            {latestScore === null ? '—' : Math.round(latestScore)}
            {latestScore !== null && <span class="text-2xl font-medium" style="color: var(--color-ink-subtle);">%</span>}
          </p>
        </div>
      </div>

      <!-- Interpretation under the score — the whole point of the page -->
      <div class="mt-5 pt-5 border-t" style="border-color: var(--color-border);">
        <p class="text-sm font-medium leading-relaxed" style={`color: ${toneColor};`}>
          {scoreInterp.headline}
        </p>
        {deltaInterp && (
          <p class="mt-2 text-sm" style="color: var(--color-ink-muted);">
            {deltaInterp.headline}
          </p>
        )}
      </div>

      <!-- KPI strip inside the same card so the right column can be taller -->
      <div class="mt-6 pt-5 border-t grid grid-cols-2 sm:grid-cols-4 gap-4"
           style="border-color: var(--color-border);">
        <div>
          <p class="text-[10px] uppercase tracking-wider font-semibold" style="color: var(--color-ink-subtle);">Last scan</p>
          <p class="mt-1 text-sm font-medium" style="color: var(--color-ink);">{fmtDate(brand.last_scan_at)}</p>
        </div>
        <div>
          <p class="text-[10px] uppercase tracking-wider font-semibold" style="color: var(--color-ink-subtle);">Next scan</p>
          <p class="mt-1 text-sm font-medium" style="color: var(--color-ink);">{fmtDate(brand.next_scan_at)}</p>
        </div>
        <div>
          <p class="text-[10px] uppercase tracking-wider font-semibold" style="color: var(--color-ink-subtle);">Total audits</p>
          <p class="mt-1 text-sm font-medium" style="color: var(--color-ink);">{audits.length}</p>
        </div>
        <div>
          <p class="text-[10px] uppercase tracking-wider font-semibold" style="color: var(--color-ink-subtle);">Cadence</p>
          <p class="mt-1 text-sm font-medium" style="color: var(--color-ink);">{frequencyLabels[brand.scan_frequency]}</p>
        </div>
      </div>
    </div>

    <!-- RIGHT (1/3): CADENCE CONTROL ====================================== -->
    <div class="card p-6">
      <h3 class="text-sm font-semibold" style="color: var(--color-ink);">Scan cadence</h3>
      <p class="mt-1 text-xs leading-relaxed" style="color: var(--color-ink-muted);">{cadenceText}</p>

      <form method="POST" class="mt-4 space-y-2">
        <input type="hidden" name="action" value="schedule" />
        {cadenceOptions.map(opt => {
          const optRank = planRank[opt.tier];
          const locked = optRank > userRank;
          const selected = brand.scan_frequency === opt.value;
          return (
            <button type="submit" name="scan_frequency" value={opt.value}
                    disabled={locked}
                    class={`w-full px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-left flex items-center justify-between gap-2 ${locked ? 'opacity-50 cursor-not-allowed' : ''}`}
                    style={selected
                      ? 'background: var(--color-brand-soft); border: 1.5px solid var(--color-brand); color: var(--color-brand-hover);'
                      : 'background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-ink);'}>
              <span>{opt.label}</span>
              {locked && (
                <span class="text-[10px] uppercase tracking-wider font-semibold px-1.5 py-0.5 rounded"
                      style="background: var(--color-surface-muted); color: var(--color-ink-muted);">
                  {opt.tier === 'solo' ? 'Solo+' : 'Pro+'}
                </span>
              )}
              {selected && !locked && (
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 13l4 4L19 7"/>
                </svg>
              )}
            </button>
          );
        })}
      </form>
    </div>
  </div>

  <!-- SCORE-OVER-TIME CHART =============================================== -->
  <div class="card p-6 mb-6">
    <div class="flex items-start justify-between gap-4 flex-wrap mb-4">
      <div>
        <h3 class="text-sm font-semibold" style="color: var(--color-ink);">Score over time</h3>
        <p class="text-xs mt-0.5" style="color: var(--color-ink-muted);">
          Each point is a scan. Click a point to drill into that audit's results.
        </p>
      </div>
    </div>
    <ScoreChart data={audits.map(a => ({
      id: a.id,
      timestamp: a.completed_at ?? a.created_at,
      score: a.visibility_score,
    }))} height={300} />
  </div>

  <!-- AUDITS TIMELINE ===================================================== -->
  <div class="card overflow-hidden mb-6">
    <div class="px-6 py-4 border-b flex items-center justify-between"
         style="border-color: var(--color-border);">
      <div>
        <h3 class="text-sm font-semibold" style="color: var(--color-ink);">Audit history</h3>
        <p class="text-xs mt-0.5" style="color: var(--color-ink-muted);">
          Every scan we've run for this brand.
        </p>
      </div>
    </div>

    {audits.length === 0 ? (
      <div class="p-10 text-center">
        <p class="text-sm" style="color: var(--color-ink-muted);">
          No audits yet.{brand.scan_frequency === 'paused' && ' Enable a cadence above to start scanning.'}
        </p>
      </div>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead style="background: var(--color-surface-muted);">
            <tr>
              <th class="text-left px-6 py-2.5 text-[11px] uppercase tracking-wider font-semibold" style="color: var(--color-ink-muted);">When</th>
              <th class="text-left px-6 py-2.5 text-[11px] uppercase tracking-wider font-semibold" style="color: var(--color-ink-muted);">Status</th>
              <th class="text-right px-6 py-2.5 text-[11px] uppercase tracking-wider font-semibold" style="color: var(--color-ink-muted);">Score</th>
              <th class="text-right px-6 py-2.5 text-[11px] uppercase tracking-wider font-semibold" style="color: var(--color-ink-muted);">Mentions</th>
              <th class="text-right px-6 py-2.5 text-[11px] uppercase tracking-wider font-semibold" style="color: var(--color-ink-muted);">Cost</th>
            </tr>
          </thead>
          <tbody>
            {audits.map(a => {
              const isDone = a.status === 'completed';
              const href = isDone ? `/dashboard/audits/${a.id}` : null;
              return (
                <tr class={`transition-colors ${isDone ? 'hover:bg-[var(--color-surface-muted)] cursor-pointer' : ''}`}
                    onclick={href ? `window.location.href='${href}'` : undefined}>
                  <td class="px-6 py-3 font-mono text-xs" style="color: var(--color-ink-muted);">
                    {fmtDate(a.created_at)}
                  </td>
                  <td class="px-6 py-3">
                    <span class="inline-flex items-center gap-1.5 text-xs font-medium px-2 py-0.5 rounded-full"
                          style={
                            a.status === 'completed' ? 'background: var(--color-ok-soft); color: var(--color-ok);' :
                            a.status === 'failed'    ? 'background: var(--color-bad-soft); color: var(--color-bad);' :
                            a.status === 'running'   ? 'background: var(--color-warn-soft); color: var(--color-warn);' :
                            'background: var(--color-surface-muted); color: var(--color-ink-muted);'
                          }>
                      {a.status}
                    </span>
                  </td>
                  <td class="px-6 py-3 text-right font-mono tabular-nums" style="color: var(--color-ink);">
                    {a.visibility_score === null ? '—' : `${Math.round(a.visibility_score)}%`}
                  </td>
                  <td class="px-6 py-3 text-right font-mono text-xs" style="color: var(--color-ink-muted);">
                    {a.mentions_count}/{a.answers_count}
                  </td>
                  <td class="px-6 py-3 text-right font-mono text-xs" style="color: var(--color-ink-muted);">
                    ${a.cost_usd.toFixed(4)}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </div>

  <!-- DANGER ZONE ========================================================= -->
  <details class="mt-10">
    <summary class="cursor-pointer text-xs uppercase tracking-wider font-semibold select-none"
             style="color: var(--color-ink-subtle);">
      Danger zone
    </summary>
    <form method="POST" class="mt-3 card p-5"
          style="border: 1px solid var(--color-bad-soft);"
          onsubmit={`return confirm("Delete ${brand.domain}? Audit history stays in your account but the brand will stop being monitored.");`}>
      <input type="hidden" name="action" value="delete" />
      <div class="flex items-center justify-between gap-4 flex-wrap">
        <div>
          <p class="text-sm font-medium" style="color: var(--color-ink);">Delete this brand</p>
          <p class="text-xs mt-0.5" style="color: var(--color-ink-muted);">
            Stops scheduled scans. Past audits stay for your records.
          </p>
        </div>
        <button type="submit"
                class="px-4 py-2 rounded-lg text-sm font-medium transition-colors"
                style="background: var(--color-bad-soft); color: var(--color-bad);">
          Delete brand
        </button>
      </div>
    </form>
  </details>

</DashboardLayout>
